    {
      "manifest": "Cargo.toml",
      "package": "zixcel-local-inference",
      "ecosystem": "rust",
      "description": "Local model catalog, acquisition contract, and verified artifact placement for Zixcel",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [
          "engine_options",
          "generation_stream",
          "inference",
          "process"
        ],
        "public_reexports": [
          "admission::{\n    AdmittedArtifact, AdmittedRuntime, ArtifactAdmission, ArtifactFormat, ArtifactProvenance,\n    CpuDerivation, CpuPreparation, CpuSelectionObservation, RegistrySnapshot, RuntimeAdmission,\n    RuntimeRegistry,\n}",
          "catalog::{CatalogStore, SourceRecord}",
          "configuration::{ModelConfiguration, RuntimeConfiguration}",
          "distribution::{\n    AdmittedDistribution, DistributionAlias, DistributionFile, HostCompatibility,\n    RuntimeDistribution,\n}",
          "dynamic_elf::DynamicMetadata",
          "error::LocalInferenceError",
          "install::{\n    install_from_file, installation_statuses, installed_models, remove_installation,\n}",
          "management::{RegistryCommand, RegistryReply, manage_registry}",
          "model::{\n    AcquisitionPlan, Approval, ArtifactDescriptor, ArtifactIntegrity, ArtifactSource, Candidate,\n    Catalog, CatalogDeliveryRequest, InstallationStatus, InstalledModel, ModelDescriptor,\n    ReleaseDescriptor, ResolvedModel, RuntimeRoute, Selection, SignedCatalog,\n}",
          "runtime::RuntimeRouteRegistry",
          "verification_control::VerificationControl"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    }
  ],
