{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zixcel://local-inference/catalog/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalogId", "sequence", "models"],
  "properties": {
    "schema": { "const": "zixcel://local-inference/catalog/v2" },
    "catalogId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "models": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/text" }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "displayName", "publisher", "licenseSpdx", "parameterCountMillions",
        "estimatedQ4Bytes", "languages", "capabilities", "recommendationRank", "releases"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/text" },
        "publisher": { "$ref": "#/$defs/text" },
        "licenseSpdx": { "$ref": "#/$defs/text" },
        "parameterCountMillions": { "type": "integer", "minimum": 0 },
        "estimatedQ4Bytes": { "type": "integer", "minimum": 0 },
        "languages": { "$ref": "#/$defs/values" },
        "capabilities": { "$ref": "#/$defs/values" },
        "recommendationRank": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "releases": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/release" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recommended", "artifacts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "recommended": { "type": "boolean" },
        "artifacts": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "filename", "kind", "format", "quantization", "priority",
        "runtimeEngines", "source", "integrity", "approval"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "filename": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "format": { "$ref": "#/$defs/id" },
        "quantization": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "runtimeEngines": { "$ref": "#/$defs/values" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision", "url"],
          "properties": {
            "repository": { "$ref": "#/$defs/text" },
            "revision": { "$ref": "#/$defs/text" },
            "url": { "type": "string", "pattern": "^https?://", "maxLength": 4096 }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "bytes"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "evidence"],
          "properties": {
            "state": { "enum": ["approved", "review-required", "rejected"] },
            "evidence": {
              "type": "array",
              "maxItems": 256,
              "items": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    }
  }
}
